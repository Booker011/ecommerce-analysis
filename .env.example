# ============================================
# 电商分析系统 - 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# ============================================

# DeepSeek API Key（可选，用于AI归因分析）
# 不填则自动降级为规则引擎模式
DEEPSEEK_API_KEY=sk-your-api-key-here

# DeepSeek API 地址（使用默认值即可）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# DeepSeek 模型（使用默认值即可）
DEEPSEEK_MODEL=deepseek-chat
